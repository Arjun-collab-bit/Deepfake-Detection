import numpy as np
from sklearn.metrics import accuracy_score, precision_recall_fscore_support, roc_curve
from scipy.optimize import brentq
from scipy.interpolate import interp1d

def evaluate_audioguard_metrics(y_true, y_pred_probs, threshold=0.5):
    """
    Calculates primary classification metrics and Equal Error Rate (EER)
    to demonstrate deepfake detection effectiveness.
    """
    # 1. Standard Metrics (Accuracy, Precision, Recall, F1)
    y_pred_classes = (y_pred_probs >= threshold).astype(int)
    accuracy = accuracy_score(y_true, y_pred_classes)
    precision, recall, f1, _ = precision_recall_fscore_support(y_true, y_pred_classes, average='binary')
    
    # 2. Equal Error Rate (EER) Calculation
    fpr, tpr, thresholds = roc_curve(y_true, y_pred_probs, pos_label=1)
    fnr = 1 - tpr
    # EER is the point where False Positive Rate equals False Negative Rate
    eer = brentq(lambda x : 1. - x - interp1d(fpr, tpr)(x), 0., 1.)
    eer_threshold = interp1d(fpr, thresholds)(eer)
    
    print(f"--- AudioGuard Final Evaluation Metrics ---")
    print(f"Accuracy:  {accuracy * 100:.2f}%")
    print(f"Precision: {precision * 100:.2f}%")
    print(f"Recall:    {recall * 100:.2f}%")
    print(f"F1-Score:  {f1:.4f}")
    print(f"EER:       {eer * 100:.2f}% (at threshold {eer_threshold:.4f})")
    
    return eer
